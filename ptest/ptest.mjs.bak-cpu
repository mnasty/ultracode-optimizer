h1{font-size:14px;margin:0 0 10px}.g{display:grid;grid-template-columns:repeat(${cols},${thumb}px);gap:10px;align-items:start}
figure{margin:0}img{width:${thumb}px;display:block;background:#000;outline:1px solid #333}figcaption{padding:3px 0 0;word-break:break-all;line-height:1.25}</style>
${opts.title ? `<h1>${esc(opts.title)}</h1>` : ''}<div class=g>${items.map(i => `<figure><img src="${pathToFileURL(i.path).href}"><figcaption>${esc(i.label)}</figcaption></figure>`).join('')}</div>`;
