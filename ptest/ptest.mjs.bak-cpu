// ptest: parallel Playwright runner + virtual time + shared visual checks for the dusk prototype.
// No deps beyond playwright-core. Import it:
//   import { runMatrix, vp, DUSK_URL } from '<ptest>/ptest.mjs';
// CLI: node ptest.mjs calibrate [--force] [--quick] | node ptest.mjs bench [a|b|c|d ...] | node ptest.mjs info
import { chromium } from 'playwright-core';
import { currentSync as govNow, ensureGovernor, admit as govAdmit } from '../governor/governor.mjs'; // machine-wide resource governor (macOS) // uc-optimizer/node_modules (npm install in the uc-optimizer folder)
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import zlib from 'node:zlib';
import crypto from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { fileURLToPath, pathToFileURL } from 'node:url';

export { chromium };
export const PTEST_DIR = path.dirname(fileURLToPath(import.meta.url));
export const CAL_FILE = path.join(PTEST_DIR, '.calibration.json');
export const REALTIME_LOG = path.join(PTEST_DIR, 'realtime-log.jsonl');
export const OUT_DIR = path.join(PTEST_DIR, 'out');
export const DUSK_FILE = process.env.PTEST_DUSK_FILE || ['/Users/mick/dev/web/memi/tests/visual/golden/dusk-v4-25-fix.html', '/Users/mick/dev/web/dusk-design-archive/dusk-design/direction-dusk-v4-25-fix.html'].find(f => fs.existsSync(f)); // the approved dusk build (durable copies; the scratch one is wiped on reboot)
export const DUSK_URL = pathToFileURL(DUSK_FILE).href;
const FONT_CACHE_DIR = path.join(PTEST_DIR, '.netcache');
const CAL_TTL_H = 24;

/* ======================================================================================================
   small utilities
   ====================================================================================================== */
const now = () => performance.now();
export const sleepReal = ms => new Promise(r => setTimeout(r, ms));
export const slug = s => String(s).toLowerCase().replace(/[^a-z0-9.@+-]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 120) || 'x';
/** '390x844' or [390,844] or {width,height} -> {width,height} */
export function vp(v) {
  if (!v) return { width: 390, height: 844 };
  if (typeof v === 'string') { const [w, h] = v.split('x').map(Number); return { width: w, height: h }; }
  if (Array.isArray(v)) return { width: v[0], height: v[1] };
  return { width: v.width, height: v.height };
}
/** the 11 viewports the energy audits use */
export const VIEWPORTS_11 = ['360x640', '375x667', '390x844', '430x932', '768x1024', '1024x768', '1280x800', '1440x900', '1920x1080', '2560x1440', '3440x1440'];
/** cartesian product: cross({vp:[...]}, {state:[...]}) -> [{vp, state}, ...] */
export function cross(...axes) {
  let out = [{}];
  for (const ax of axes) for (const [k, vals] of Object.entries(ax)) out = out.flatMap(o => vals.map(v => ({ ...o, [k]: v })));
  return out;
}
/** stable, readable id for a case: name, else viewport + every scalar field */
export function caseId(c) {
  if (c.name) return slug(c.name);
  const v = vp(c.vp || c.viewport);
  const parts = [`${v.width}x${v.height}`];
  if (c.dpr && c.dpr !== 1) parts.push(`dpr${c.dpr}`);
  if (c.reducedMotion === 'reduce' || c.rm) parts.push('rm');
  if (c.colorScheme) parts.push(c.colorScheme);
  for (const [k, val] of Object.entries(c)) {
    if (['name', 'vp', 'viewport', 'dpr', 'touch', 'hasTouch', 'isMobile', 'reducedMotion', 'rm', 'colorScheme', 'virtual', 'timeout', 'url', 'dir', '__suite'].includes(k)) continue;
    if (val == null || typeof val === 'object' || typeof val === 'function') continue;
    parts.push(typeof val === 'boolean' ? (val ? k : 'no' + k) : k === 'seed' ? `seed${val}` : `${val}`);
  }
  return slug(parts.join('-'));
}
const fmtMs = ms => ms >= 10000 ? (ms / 1000).toFixed(1) + 's' : ms >= 1000 ? (ms / 1000).toFixed(2) + 's' : Math.round(ms) + 'ms';
const pad = (s, n) => { s = String(s); return s.length >= n ? s.slice(0, n) : s + ' '.repeat(n - s.length); };
const median = a => { if (!a.length) return 0; const s = [...a].sort((x, y) => x - y); const m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
const quantile = (a, q) => { if (!a.length) return NaN; const s = [...a].sort((x, y) => x - y); return s[Math.min(s.length - 1, Math.max(0, Math.round(q * (s.length - 1))))]; };

/* ======================================================================================================
   system metrics: memory pressure + swap activity, recorded next to every throughput point
   ====================================================================================================== */
const sh = (cmd, args) => { try { return execFileSync(cmd, args, { encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'ignore'] }); } catch { return ''; } };
export function sysSnapshot() {
  const vm = sh('vm_stat', []);
  const pageSize = +(/page size of (\d+)/.exec(vm) || [0, 16384])[1];
  const num = k => { const m = new RegExp(k + ':\\s+(\\d+)').exec(vm); return m ? +m[1] : null; };
  const sw = sh('sysctl', ['-n', 'vm.swapusage']);
  const mb = k => { const m = new RegExp(k + ' = ([\\d.]+)M').exec(sw); return m ? +m[1] : null; };
  const mp = sh('memory_pressure', ['-Q']);
  const free = /free percentage: (\d+)%/.exec(mp);
  const lvl = sh('sysctl', ['-n', 'kern.memorystatus_vm_pressure_level']).trim();
  const cpu = os.cpus().reduce((a, c) => { const t = c.times; a.idle += t.idle; a.total += t.user + t.nice + t.sys + t.idle + t.irq; return a; }, { idle: 0, total: 0 });
  return {
    t: Date.now(), load1: +os.loadavg()[0].toFixed(2), cpuIdle: cpu.idle, cpuTotal: cpu.total, freeMemPct: free ? +free[1] : null,
    pressureLevel: lvl ? ({ 1: 'normal', 2: 'warn', 4: 'critical' }[lvl] || lvl) : null,
    pageouts: num('Pageouts'), swapouts: num('Swapouts'), swapins: num('Swapins'), pageSize,
    swapUsedMB: mb('used'), swapTotalMB: mb('total'),
  };
}
export function sysDelta(a, b) {
  return {
    load1: b.load1, cpuBusyPct: b.cpuTotal > a.cpuTotal ? Math.round(100 * (1 - (b.cpuIdle - a.cpuIdle) / (b.cpuTotal - a.cpuTotal))) : null, freeMemPct: b.freeMemPct, pressureLevel: b.pressureLevel, swapUsedMB: b.swapUsedMB,
    swapUsedDeltaMB: a.swapUsedMB != null && b.swapUsedMB != null ? +(b.swapUsedMB - a.swapUsedMB).toFixed(1) : null,
    pageoutsDelta: a.pageouts != null ? b.pageouts - a.pageouts : null,
    swapoutsDelta: a.swapouts != null ? b.swapouts - a.swapouts : null,
    swapinsDelta: a.swapins != null ? b.swapins - a.swapins : null,
  };
}

/* ======================================================================================================
   network cache: Google Fonts css/woff2 served from memory/disk to every context (each BrowserContext
   otherwise refetches them; that is network wait per case, and a flake source when many run at once)
   ====================================================================================================== */
const memNet = new Map(); const netInflight = new Map();
const NET_RE = /^https:\/\/fonts\.(googleapis|gstatic)\.com\//;
async function netCached(route) {
  const url = route.request().url();
  const key = crypto.createHash('sha1').update(url).digest('hex');
  try {
    let hit = memNet.get(key);
    if (!hit) {
      const f = path.join(FONT_CACHE_DIR, key);
      if (fs.existsSync(f + '.json')) { hit = { ...JSON.parse(fs.readFileSync(f + '.json', 'utf8')), body: fs.readFileSync(f + '.bin') }; memNet.set(key, hit); }
    }
    if (!hit) {
      if (!netInflight.has(key)) netInflight.set(key, (async () => {
        const resp = await route.fetch(); const body = await resp.body();
        const headers = { ...resp.headers() }; delete headers['content-encoding']; delete headers['content-length'];
        const rec = { status: resp.status(), headers, body };
        if (resp.status() === 200) { fs.mkdirSync(FONT_CACHE_DIR, { recursive: true }); fs.writeFileSync(path.join(FONT_CACHE_DIR, key) + '.bin', body); fs.writeFileSync(path.join(FONT_CACHE_DIR, key) + '.json', JSON.stringify({ status: rec.status, headers, url })); memNet.set(key, rec); }
        return rec;
      })().finally(() => netInflight.delete(key)));
      hit = await netInflight.get(key);
    }
    await route.fulfill({ status: hit.status, headers: { ...hit.headers, 'access-control-allow-origin': '*' }, body: hit.body });
  } catch (e) { try { await route.continue(); } catch { } }
}

/* ======================================================================================================
   virtual time
   page.clock (Playwright) fakes Date, setTimeout/setInterval, requestAnimationFrame, requestIdleCallback,
   performance.now, Intl.DateTimeFormat default dates and Event.timeStamp. It does NOT touch CSS animations,
   CSS transitions or Web Animations: those run on the document timeline (real time). ANIM_SHIM below takes
   every running animation, pauses it, and sets its currentTime from the fake clock at every 16ms virtual
   tick (and once per real frame), finishing it (finished promise, transitionend, animationend) when virtual
   time passes its end. So `await anim.finished` chains and rAF loops follow page.clock.runFor().
   ====================================================================================================== */
// Playwright's clock yields a native setTimeout(0) after EVERY fired timer; Chrome clamps nested timeouts to 4ms, so a
// timer-heavy page ran ~4.5ms real per virtual timer (2000 x 1ms timers: 9071ms). FAST_YIELD routes those zero-delay yields
// through a MessageChannel (a full macrotask: microtasks drain, no clamp): the same 2000 timers take 12ms.
const FAST_YIELD = `(() => {
  const pw = globalThis.__pwClock; if (!pw || pw.__ptestFast) return; pw.__ptestFast = true;
  const e = pw.controller._embedder, nst = e.setTimeout, mc = new MessageChannel(), q = [];
  mc.port1.onmessage = () => { const f = q.shift(); f && f(); };
