    release() { enabled = false; for (const [a] of C) { try { o.play.call(a); } catch (e) {} } C.clear(); } };
})();`;

/** init script that replaces Math.random with a seeded PRNG (mulberry32), so random app choices repeat run to run */
export const seedScript = seed => `(() => { let a = (${Number(seed) >>> 0}) >>> 0; Math.random = function random() { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();`;
/**
 * Install virtual time on a page BEFORE page.goto(). The clock is paused at `time`; nothing timer-driven
 * moves until runFor()/runUntil()/fastForward(). opts.animations: 'sync' (default, CSS/WAAPI follow the
 * fake clock) | 'real' (leave animations on real time).
 */
export async function installVirtualTime(page, opts = {}) {
  const time = opts.time != null ? +new Date(opts.time) : Date.parse('2026-10-27T23:30:00');
  // the installed clock runs on real time until pauseAt: start it well before `time`, so a slow machine (seen: > 1 s between
  // these two calls at load 200, 'Cannot fast-forward to the past') still pauses exactly at `time`
  await page.clock.install({ time: time - 120000 });
  await page.clock.pauseAt(time);
  const scripts = [opts.fastYield !== false && FAST_YIELD, opts.timerErrors !== false && TIMER_ERRORS, opts.animations !== 'real' && ANIM_SHIM(opts.syncEvery || 32)].filter(Boolean);
  for (const sc of scripts) await page.addInitScript(sc);
  // also into the document that is already there (about:blank), so page.setContent() pages get them too
  for (const sc of scripts) await page.evaluate(sc).catch(() => { });
  page.__ptestVirtual = { time, animations: opts.animations || 'sync' };
  return page;
}
export const isVirtual = page => !!page.__ptestVirtual;
const syncAnims = page => page.evaluate(() => window.__ptestAnim && window.__ptestAnim.sync()).catch(() => {});
// An app error thrown inside a timer / rAF callback is rethrown by page.clock (after it has run the rest of the span) instead of
// reaching 'pageerror'. clockCall turns it back into a page error: page.__ptestTimerError(msg) (runMatrix records it in
// t.errors.pageErrors, so failOnPageError decides, exactly as in real time). Without a handler, or when the page/browser is gone, it throws.
async function clockCall(page, what, f) {
  try { return await f(); }
  catch (e) {
    const msg = String(e && e.message || e);
    if (!page.__ptestTimerError || page.isClosed() || /has been closed|Target closed|Browser closed|crash/i.test(msg)) throw e;
    page.__ptestTimerError(msg.replace(/^clock\.\w+:\s*/, '').replace(/^\w*Error:\s*/, '').split('\n')[0], what);
  }
}
/** advance virtual time by ms, firing every timer/rAF in order; animations follow */
export async function runFor(page, ms) {
  if (!page.__ptestVirtual) throw new Error('runFor: virtual time not installed on this page (installVirtualTime before goto, or case.virtual)');
  await clockCall(page, 'runFor', () => page.clock.runFor(Math.max(0, Math.round(ms)))); await syncAnims(page);
}
/** jump ahead WITHOUT firing intervals in between (each due timer fires at most once) */
export async function fastForward(page, ms) { await clockCall(page, 'fastForward', () => page.clock.fastForward(Math.round(ms))); await syncAnims(page); }
