})();`;
// page.clock catches an exception thrown by a timer / rAF callback and rethrows only the first one from runFor (no 'pageerror').
// TIMER_ERRORS wraps the fake timer functions so every such exception goes through reportError(): an ordinary uncaught page
// error, exactly what real time gives, and the clock never sees a throw.
const TIMER_ERRORS = `(() => {
  if (!globalThis.__pwClock || globalThis.__ptestTimerWrap) return; globalThis.__ptestTimerWrap = true;
  const wrap = cb => typeof cb !== 'function' ? cb : function (...a) { try { return cb.apply(this, a); } catch (e) { try { reportError(e); } catch (e2) { setTimeout(() => { throw e; }); } } };
  for (const k of ['setTimeout', 'setInterval', 'requestAnimationFrame', 'requestIdleCallback', 'queueMicrotask']) {
    const f = globalThis[k]; if (typeof f !== 'function') continue;
    const w = { [k](cb, ...rest) { return f.call(this, wrap(cb), ...rest); } }[k];
    try { Object.defineProperty(globalThis, k, { value: w, writable: true, configurable: true }); } catch (e) {}
  }
})();`;
const ANIM_SHIM = syncMs => `(() => {
  if (window.__ptestAnim || !globalThis.__pwClock) return;
  const SYNC_MS = ${syncMs};
  const pw = globalThis.__pwClock, ctl = pw.controller, nat = pw.builtin, realPerf = nat.performance;
  const vnow = () => ctl.performanceNow();
  const AP = Animation.prototype, EP = Element.prototype;
  const o = { pause: AP.pause, play: AP.play, finish: AP.finish, cancel: AP.cancel, reverse: AP.reverse, upr: AP.updatePlaybackRate, animate: EP.animate };
  const ctD = Object.getOwnPropertyDescriptor(AP, 'currentTime'), prD = Object.getOwnPropertyDescriptor(AP, 'playbackRate');
  const getCT = a => ctD.get.call(a), setCT = (a, v) => ctD.set.call(a, v);
  const C = new Map(), appPaused = new WeakSet(), SV = new Map();
  const SMIL = ['animate', 'animateTransform', 'animateMotion', 'set'].map(t => document.getElementsByTagNameNS('http://www.w3.org/2000/svg', t));
  // document.timeline.currentTime reads virtual time too (it is performance.now()'s twin in real time)
  try { Object.defineProperty(document.timeline, 'currentTime', { configurable: true, get: () => vnow() }); } catch (e) {}
  let enabled = true, lastReal = realPerf.now(), taken = 0, finished = 0;
  const endOf = a => { try { return a.effect ? a.effect.getComputedTiming().endTime : 0; } catch (e) { return Infinity; } };
  const due = a => { const r = C.get(a); if (!r) return; const rate = prD.get.call(a), tgt = r.t0 + (vnow() - r.v0) * rate, end = endOf(a);
    if ((rate > 0 && tgt >= end - 0.5) || (rate < 0 && tgt <= 0.5)) { C.delete(a); finished++; try { o.finish.call(a); } catch (e) {} if (wantsEvent(a)) pw.__needFrame = true; }
    else { r.end = end; if (rate > 0 && isFinite(end)) setTimeout(() => due(a), Math.max(1, (end - tgt) / rate)); } };
  const take = (a, t0) => { try { o.pause.call(a); setCT(a, t0); const rate = prD.get.call(a), end = endOf(a);
    C.set(a, { v0: vnow(), t0, end, last: t0 }); taken++;
    if (rate > 0 && isFinite(end)) setTimeout(() => due(a), Math.max(0, (end - t0) / rate)); else if (rate < 0) setTimeout(() => due(a), Math.max(0, t0 / -rate)); // exact virtual end
  } catch (e) {} };
  let syncs = 0, syncMs = 0;
  function sync() { const s0 = realPerf.now(); try { sync0(); } finally { syncs++; syncMs += realPerf.now() - s0; } }
  function sync0() {
    if (!enabled) return;
    const v = vnow(), rn = realPerf.now(), realSince = Math.max(0, rn - lastReal); lastReal = rn;
    let list; try { list = document.getAnimations(); } catch (e) { return; }
    for (const a of list) {
      if (C.has(a) || appPaused.has(a) || a.playState !== 'running') continue;
      let ct = getCT(a); if (ct == null) ct = 0;
      const rate = prD.get.call(a);
      take(a, rate > 0 ? ct - Math.min(Math.max(ct, 0), realSince * rate) : ct); // undo the real time it ran before we saw it
    }
