/** the allowance for one run: what the others leave free, at least an equal share of the budget */
export function allowance(others, budget = pageBudget()) {
  const fair = Math.max(1, Math.floor(budget / (others.runs + 1)));
  return Math.max(fair, budget - others.pages);
