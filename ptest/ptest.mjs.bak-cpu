/* ======================================================================================================
   dusk prototype helpers (used by the examples and the calibration workload)
   ====================================================================================================== */
export const dusk = {
  /** goto the prototype (optionally ?query), let boot timers run (virtual or real) */
  async open(t, { query = '', settle = 600 } = {}) {
    await t.page.goto(DUSK_URL + query);
    await t.runFor(settle);
  },
  /** jump to step n (0..6) */
  async jump(t, n, { question = 'will i get the job?', reversals = true, settle = 1500 } = {}) {
    await t.page.evaluate(([n, q, rev]) => { window.__dusk.S.useReversals = rev; window.__dusk.S.question = q; window.__dusk.jumpTo(n); }, [n, question, reversals]);
    if (settle) await t.runFor(settle);
  },
  /** step ii -> energy, wait until the moon has risen onto the stage */
  async energy(t, o = {}) {
    await dusk.jump(t, 2, { ...o, settle: 0 });
    await t.runUntil(() => window.__dusk.risen, { step: 50, max: 10000 });
  },
  async moonCenter(t) { const b = await t.page.locator('#lune').boundingBox(); return { x: b.x + b.width / 2, y: b.y + b.height / 2 }; },
  /** b10 Z11: the deck under the mascot is the press target (#deckBtn); builds before it only have the moon */
  async cardsCenter(t) { const b = await t.page.locator((await t.page.$('#deckBtn')) ? '#deckBtn' : '#lune').boundingBox(); return { x: b.x + b.width / 2, y: b.y + b.height / 2 }; },
  async press(t) { const p = await dusk.cardsCenter(t); await t.page.mouse.move(p.x, p.y); await t.page.mouse.down(); },
  async release(t) { await t.page.mouse.up(); },
};

/* ======================================================================================================
   calibrate(): measure throughput at increasing concurrency on a representative workload
   ====================================================================================================== */
/** representative case: open, energy, hold 6s virtual, audit, screenshot */
export async function calibrationWorkload(t) {
  await dusk.open(t);
  await dusk.energy(t);
  await dusk.press(t);
  if (t.page.__ptestVirtual) await t.runFor(6000); else await t.page.waitForTimeout(3000);
  const a = await t.audit({ root: '#s2' });
  await t.page.screenshot();
  await dusk.release(t);
  return { findings: a.findings.length, progress: await t.page.evaluate(() => window.__dusk.progress) };
}
async function measureLevel(c, { profile, browsers, casesPer, workload }) {
  const n = Math.max(casesPer, c * 2);
  const cases = Array.from({ length: n }, (_, i) => ({ name: `cal-${profile}-${c}-${i}`, vp: i % 2 ? '1440x900' : '390x844', virtual: profile === 'virtual' }));
  const pool = await launchPool(browsers);
  const s0 = sysSnapshot(); let mid = null;
  const midT = setTimeout(() => { mid = sysSnapshot(); }, 1500);
  const t0 = now();
  const rep = await runMatrix(cases, workload, { name: `calibrate-${profile}-${c}`, concurrency: c, quiet: true, backoff: false, pool, timeout: 120000 });
  const wall = now() - t0; clearTimeout(midT);
  await Promise.all(pool.map(b => b.close().catch(() => { })));
  const s1 = sysSnapshot();
  const ok = rep.results.filter(r => r.ok);
  return { c, browsers, cases: n, failures: rep.failed, firstError: rep.failed ? rep.results.find(r => !r.ok).error : undefined, wallMs: Math.round(wall), throughput: +(n / (wall / 1000)).toFixed(3), perCaseMs: Math.round(median(ok.map(r => r.ms))), sys: { ...sysDelta(s0, s1), freeMemPctMid: mid ? mid.freeMemPct : null, swapUsedMBMid: mid ? mid.swapUsedMB : null } };
}
export async function calibrate(opts = {}) {
  const C0 = os.cpus().length;
  const levelsV = opts.levels || (opts.quick ? [1, 4, 8, 12, 16] : [1, 2, 4, 6, 8, 10, 12, 16, 20, 24, 32]);
  const levelsR = opts.realtimeLevels || (opts.quick ? [8, 16] : [4, 8, 16, 24, 32, 48]);
  const workload = opts.workload || calibrationWorkload;
  const casesPer = opts.casesPer || 8;
  const res = { machine: machineKey(), createdAt: Date.now(), ttlHours: CAL_TTL_H, chrome: null, sysBefore: sysSnapshot(),
    workload: workload === calibrationWorkload ? 'dusk energy: open, rise, hold 6s virtual (3s real for realtime), bboxAudit #s2, fast screenshot; 390x844 + 1440x900 alternating' : 'custom',
    rules: 'phase 1: best contexts-per-browser at concurrency = cpu count; phase 2: concurrency sweep with that pool shape. knee = max throughput; step back to a lower level if within 5% throughput while the higher costs >25% more per case. No memory floor: memory pressure, swap use and pageout/swapout deltas are recorded per level.' };
  { const b = await chromium.launch({ channel: 'chrome' }); res.chrome = b.version(); await b.close(); }
  await runMatrix([{ name: 'warm', vp: '390x844', virtual: true }], workload, { concurrency: 1, quiet: true }); // font cache warm
  const line = (profile, m) => console.log(`[calibrate] ${profile} c=${pad(m.c, 3)} browsers=${pad(m.browsers, 3)}${pad(m.cases + ' cases', 9)} wall ${pad(fmtMs(m.wallMs), 7)} throughput ${pad(m.throughput.toFixed(2) + '/s', 8)} perCase ${pad(fmtMs(m.perCaseMs), 7)} gain ${pad(m.gainVsPrev == null ? '-' : m.gainVsPrev + '%', 7)} slowdown ${pad(m.perCaseSlowdownVsPrev == null ? '-' : m.perCaseSlowdownVsPrev + '%', 7)} fail ${m.failures} | free ${m.sys.freeMemPct}% (mid ${m.sys.freeMemPctMid}%) pressure ${m.sys.pressureLevel} swap ${m.sys.swapUsedMB}MB (${m.sys.swapUsedDeltaMB >= 0 ? '+' : ''}${m.sys.swapUsedDeltaMB}) pageouts +${m.sys.pageoutsDelta} swapouts +${m.sys.swapoutsDelta} cpu ${m.sys.cpuBusyPct}% load ${m.sys.load1}`);
  // phase 1: pool shape. PNG encoding + CDP dispatch live in the browser process, so one browser saturates long before the CPUs do
  const shapes = [...new Set(opts.poolSizes || [1, 2, Math.ceil(C0 / 4), Math.ceil(C0 / 2), C0])].filter(b => b <= C0).sort((a, b) => a - b);
  const shape = [];
  for (const b of shapes) { const m = await measureLevel(C0, { profile: 'virtual', browsers: b, casesPer: Math.max(casesPer, C0 * 2), workload }); shape.push(m); line('pool', m); }
  const bestS = shape.reduce((a, b) => b.throughput > a.throughput ? b : a);
  const pick = shape.find(m => m.throughput >= bestS.throughput * 0.95) || bestS; // fewest browsers within 5% of the best
  const k = C0 / pick.browsers;
