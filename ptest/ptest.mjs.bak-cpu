    // drive its clock from virtual time (getCurrentTime() at first sight = the real time it already ran)
    if (SMIL.some(col => col.length)) for (const col of SMIL) for (const el of col) {
      let r = el.ownerSVGElement; while (r && r.ownerSVGElement) r = r.ownerSVGElement;
      if (r && !SV.has(r)) { try { r.pauseAnimations(); SV.set(r, { v0: v, t0: r.getCurrentTime() }); } catch (e) {} }
    }
    for (const [r, q] of SV) { if (!r.isConnected) { SV.delete(r); continue; } try { r.setCurrentTime(q.t0 + (v - q.v0) / 1000); } catch (e) {} }
    const alive = new Set(list);
    for (const [a, r] of C) {
      if (!alive.has(a)) { C.delete(a); continue; } // cancelled / removed
      const rate = prD.get.call(a), tgt = r.t0 + (v - r.v0) * rate;
      if ((rate > 0 && tgt >= r.end) || (rate < 0 && tgt <= 0)) { due(a); continue; }
