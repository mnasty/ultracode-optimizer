export async function pauseAt(page, time) { await clockCall(page, 'pauseAt', () => page.clock.pauseAt(+new Date(time))); await syncAnims(page); }
/** wait n REAL rendering frames (native rAF, even under a fake clock): lets IntersectionObserver/ResizeObserver callbacks and
 *  animation events, which only run on rendering frames, fire before you advance virtual time again */
export const realFrames = (page, n = 2) => page.evaluate(n => new Promise(r => { const raf = (window.__pwClock && window.__pwClock.builtin.requestAnimationFrame) || requestAnimationFrame; let k = 0; const f = () => ++k >= n ? r() : raf(f); raf(f); }), n);
/** virtual performance.now() in the page */
export const vnow = page => page.evaluate(() => performance.now());
/**
 * advance virtual time in `step` ms slices until predicate(arg) is truthy in the page.
 * returns the virtual ms it took. throws after `max` virtual ms.
