/**
 * knee: highest throughput, but step back to a lower level when that level is within `within` (5%) of the higher
 * level's throughput and the step up costs > `slow` (25%) more per case: extra parallelism that only queues.
 */
export function pickKnee(levels, { within = 0.05, slow = 0.25 } = {}) {
  const ok = levels.filter(l => l.failures === 0 || l.failures == null);
  if (!ok.length) return { knee: 1, reason: 'every level had failures' };
  let best = ok.reduce((a, b) => b.throughput > a.throughput ? b : a);
  const lower = ok.filter(l => l.c < best.c).sort((a, b) => b.c - a.c);
  let reason = `max throughput ${best.throughput.toFixed(2)}/s at ${best.c}`;
  for (const l of lower) {
