export const maxBrowsers = () => +process.env.PTEST_MAX_BROWSERS || Infinity; // browsers grow with the limit while the governor says ok
const pidAlive = pid => { try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; } };
/** the other runs' leases: { runs, pages } (stale leases, dead pids or no heartbeat for 15 s, are removed) */
export function leaseOthers(selfFile) {
  let runs = 0, pages = 0;
  try {
    for (const f of fs.readdirSync(LEASE_DIR)) {
      if (!f.endsWith('.json')) continue;
      const p = path.join(LEASE_DIR, f); if (p === selfFile) continue;
