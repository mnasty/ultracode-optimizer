export async function runUntil(page, predicate, { step = 50, max = 60000, arg } = {}) {
  let spent = 0;
  const fnSrc = typeof predicate === 'string' ? `() => (${predicate})` : predicate.toString();
  const check = () => page.evaluate(([src, a]) => { try { return !!(0, eval)('(' + src + ')')(a); } catch (e) { return false; } }, [fnSrc, arg]);
  while (!(await check())) {
