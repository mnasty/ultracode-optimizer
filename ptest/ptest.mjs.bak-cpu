  console.log(`[calibrate] pool: ${pick.browsers} browser(s) at c=${C0} -> ${k.toFixed(1)} contexts per browser`);
  const sweep = async (profile, levels) => {
    const out = []; let flat = 0;
    for (const c of levels) {
      let m;
      try { m = await measureLevel(c, { profile, browsers: Math.max(1, Math.ceil(c / k)), casesPer, workload }); }
      catch (e) { console.log(`[calibrate] ${profile} c=${c}: level failed (${String(e.message).split('\n')[0]}), stopping the sweep`); out.push({ c, browsers: Math.ceil(c / k), failures: 1, throughput: 0, perCaseMs: 0, error: String(e.message).split('\n')[0] }); break; }
      const prev = out[out.length - 1];
      m.gainVsPrev = prev ? +((m.throughput / prev.throughput - 1) * 100).toFixed(1) : null;
      m.perCaseSlowdownVsPrev = prev ? +((m.perCaseMs / prev.perCaseMs - 1) * 100).toFixed(1) : null;
      out.push(m); line(profile, m);
      if (prev && m.gainVsPrev < 5) flat++; else flat = 0;
      if (flat >= 2 && !opts.full) { console.log(`[calibrate] ${profile}: two levels without a 5% gain, stopping the sweep`); break; }
    }
    return out;
  };
  const v = await sweep('virtual', levelsV);
  res.virtual = { levels: v, ...pickKnee(v) }; res.virtual.browsers = Math.max(1, Math.ceil(res.virtual.knee / k));
  console.log(`[calibrate] virtual knee = ${res.virtual.knee} on ${res.virtual.browsers} browser(s): ${res.virtual.reason}`);
  res.browsers = { pick: res.virtual.browsers };
  if (!opts.skipRealtime) {
    const r = await sweep('realtime', levelsR);
    res.realtime = { levels: r, ...pickKnee(r) }; res.realtime.browsers = Math.max(1, Math.ceil(res.realtime.knee / k));
    console.log(`[calibrate] realtime knee = ${res.realtime.knee} on ${res.realtime.browsers} browser(s): ${res.realtime.reason}`);
  }
  res.sysAfter = sysSnapshot();
  const loads = [...(res.pool.tested || []), ...res.virtual.levels].map(l => l.sys && l.sys.load1).filter(x => x != null);
  res.maxLoadDuring = Math.max(res.sysBefore.load1, ...loads);
  // note: on this Mac the load average climbed to 500 while the CPUs were 73% idle (other agents' browsers), so it is recorded, not trusted
  if (res.maxLoadDuring > 2 * C0) { res.contaminated = true; console.log(`[calibrate] WARNING load average reached ${res.maxLoadDuring} (> 2 x ${C0} cpus): other work was running; compare the cpu% column, re-run when the machine is quiet.`); }
  fs.writeFileSync(CAL_FILE, JSON.stringify(res, null, 1));
  console.log(`[calibrate] wrote ${CAL_FILE}`);
  console.log('[calibrate] optional: runMatrix keeps its default (cpu count, 5 contexts per browser) unless PTEST_USE_CALIBRATION=1 is set, and ignores a contaminated or stale calibration');
  return res;
}

/* ======================================================================================================
   CLI
   ====================================================================================================== */
async function cli(argv) {
  const [cmd, ...rest] = argv;
  if (cmd === 'calibrate') {
    const cur = readCalibration({ allowStale: false });
    if (cur && !rest.includes('--force')) { console.log(`[calibrate] fresh calibration exists (virtual knee ${cur.virtual.knee} on ${cur.virtual.browsers} browser(s), realtime knee ${cur.realtime && cur.realtime.knee}); --force to redo`); return; }
    await calibrate({ quick: rest.includes('--quick'), full: rest.includes('--full'), skipRealtime: rest.includes('--no-realtime') });
  } else if (cmd === 'bench') {
    const { runBenchmarks } = await import(pathToFileURL(path.join(PTEST_DIR, 'examples', 'bench.mjs')).href);
    await runBenchmarks(rest);
  } else if (cmd === 'run') {
    // node ptest.mjs run a.mjs b.mjs ... : each file exports `suite` (or `bench`) = {name, cases, fn, after?, opts?}, or `cases` + `fn`
    const files = rest.filter(f => !f.startsWith('--')); const suites = [];
    for (const f of files) {
      const m = await import(pathToFileURL(path.resolve(f)).href);
      const su = m.suite || m.bench || (m.cases && m.fn ? { name: path.basename(f, path.extname(f)), cases: m.cases, fn: m.fn, after: m.after, opts: m.opts } : null);
      if (!su) throw new Error(`${f}: export suite = {name, cases, fn} (or cases + fn)`);
      suites.push(su);
    }
    const rep = await runSuites(suites);
    process.exitCode = rep.ok ? 0 : 1; return;
  } else if (cmd === 'info') {
    console.log(JSON.stringify({ concurrency: resolveConcurrency(), calibration: readCalibration() && { createdAt: new Date(readCalibration().createdAt).toISOString(), stale: readCalibration().stale }, sys: sysSnapshot() }, null, 1));
  } else {
    console.log('usage: node ptest.mjs run file.mjs [file2.mjs ...] (one pool for all) | node ptest.mjs calibrate [--force] [--quick] [--full] [--no-realtime] (optional) | node ptest.mjs bench [a b c d] [--serial-only|--parallel-only|--realtime-baseline] | node ptest.mjs info');
  }
}
if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  cli(process.argv.slice(2)).then(() => process.exit(process.exitCode || 0), e => { console.error(e); process.exit(1); });
}
