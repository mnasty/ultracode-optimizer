  // frame after a finish only when someone listens for them, so silent animations cost nothing
  const EV = /^(animationend|animationiteration|animationcancel|transitionend|transitioncancel|finish|cancel)$/;
  const listening = new WeakSet(); let globalListen = false;
  const ETP = EventTarget.prototype, oAdd = ETP.addEventListener;
  ETP.addEventListener = function (type, ...rest) { if (EV.test(type)) { if (this === window || this === document || this === document.documentElement || this === document.body) globalListen = true; else listening.add(this); } return oAdd.call(this, type, ...rest); };
  for (const [proto, props] of [[AP, ['onfinish', 'oncancel']], [HTMLElement.prototype, ['onanimationend', 'ontransitionend', 'onanimationiteration']], [SVGElement.prototype, ['onanimationend', 'ontransitionend']], [Document.prototype, ['onanimationend', 'ontransitionend']]]) for (const k of props) {
    let d = null; for (let p = proto; p && !d; p = Object.getPrototypeOf(p)) d = Object.getOwnPropertyDescriptor(p, k);
    if (!d || !d.set) continue;
    Object.defineProperty(proto, k, { configurable: true, enumerable: d.enumerable, get: d.get, set(v) { if (v) { if (this instanceof Document) globalListen = true; else listening.add(this); } d.set.call(this, v); } });
  }
  window.addEventListener = function (type, ...rest) { if (EV.test(type)) globalListen = true; return oAdd.call(this, type, ...rest); };
  const wantsEvent = a => { if (globalListen || listening.has(a)) return true; const tg = a.effect && a.effect.target; for (let x = tg; x; x = x.parentElement) if (listening.has(x)) return true; return false; };
  EP.animate = function (...args) { const a = o.animate.apply(this, args); if (enabled) take(a, getCT(a) || 0); return a; };
  AP.play = function () { const r = o.play.call(this); appPaused.delete(this); if (enabled) take(this, getCT(this) || 0); return r; };
  AP.pause = function () { C.delete(this); appPaused.add(this); return o.pause.call(this); };
  AP.finish = function () { C.delete(this); return o.finish.call(this); };
  AP.cancel = function () { C.delete(this); return o.cancel.call(this); };
  AP.reverse = function () { const r = o.reverse.call(this); appPaused.delete(this); if (enabled) take(this, getCT(this) || 0); return r; };
  AP.updatePlaybackRate = function (x) { const r = C.get(this); if (r) { r.t0 = getCT(this); r.v0 = vnow(); prD.set.call(this, x); return; } return o.upr.call(this, x); };
  Object.defineProperty(AP, 'currentTime', { configurable: true, enumerable: true, get: ctD.get, set(x) { ctD.set.call(this, x); const r = C.get(this); if (r) { r.t0 = x; r.v0 = vnow(); r.last = x; } } });
  Object.defineProperty(AP, 'playbackRate', { configurable: true, enumerable: true, get: prD.get, set(x) { const r = C.get(this); if (r) { r.t0 = getCT(this); r.v0 = vnow(); } prD.set.call(this, x); } });
