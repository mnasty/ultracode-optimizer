/* ======================================================================================================
   real-time confirmation: the one place a timing claim is proven on the wall clock
   ====================================================================================================== */
/**
 * realTimeConfirm(name, fn, {claim}) runs fn on REAL time, logs it, appends a JSON line to realtime-log.jsonl.
 * Use it once per timing claim (e.g. "a 30s hold fills at 30.0 +/- 0.3s"), then test everything else virtually.
 */
export async function realTimeConfirm(name, fn, opts = {}) {
  const startedAt = new Date().toISOString(), t0 = now();
  console.log(`[real-time] ${name}: start${opts.claim ? ' | claim: ' + opts.claim : ''}`);
  let value, error;
  try { value = await fn(); } catch (e) { error = e; }
  const wallMs = Math.round(now() - t0);
  const rec = { name, claim: opts.claim || null, startedAt, wallMs, ok: !error, value: value === undefined ? null : value, error: error ? String(error.message || error) : null };
  try { fs.appendFileSync(opts.log || REALTIME_LOG, JSON.stringify(rec) + '\n'); } catch { }
  console.log(`[real-time] ${name}: ${error ? 'FAILED ' + rec.error : 'done'} in ${fmtMs(wallMs)}`);
  if (error) throw error;
  return value;
}

/* ======================================================================================================
   calibration cache + concurrency resolution
   ====================================================================================================== */
function machineKey() { return `${os.hostname()}|${os.cpus().length}cpu|${Math.round(os.totalmem() / 2 ** 30)}GB|${os.arch()}`; }
export function readCalibration({ allowStale = true } = {}) {
  try {
    const c = JSON.parse(fs.readFileSync(CAL_FILE, 'utf8'));
    if (c.machine !== machineKey()) return null;
    c.stale = Date.now() - c.createdAt > (c.ttlHours || CAL_TTL_H) * 3600e3;
    return c.stale && !allowStale ? null : c;
  } catch { return null; }
}
/**
 * Simple default, set from the measurements already recorded (bench-results.json, .calibration.json, PROGRESS.md):
 *  - concurrency = cpu count (10 on this Mac): quiet-machine bench d ran 6 viewports in 8.1s at c=6 vs 13.1s serial;
 *    the calibration sweeps put the best virtual throughput at c=10 (1.67/s), with c=12-16 slower.
 *  - 5 contexts per browser (2 browsers at c=10): pool test at c=10 measured 1 browser 1.90/s, 2 browsers 2.33/s,
 *    3 browsers 1.28/s, 5 browsers 0.74/s. One browser process caps out on PNG encoding + CDP dispatch.
 * Overrides, highest first: opts.concurrency / env PTEST_CONCURRENCY, opts.browsers / env PTEST_BROWSERS.
 * The calibration cache is consulted only when asked for (opts.useCalibration or env PTEST_USE_CALIBRATION=1),
 * and never when it is stale or was recorded on a loaded machine (contaminated).
 */
export const DEFAULT_CONTEXTS_PER_BROWSER = 5;
export const defaultConcurrency = () => Math.max(2, os.cpus().length);
export function resolveConcurrency(opts = {}) {
  const envB = +process.env.PTEST_BROWSERS || 0;
  const shape = v => opts.browsers || envB || Math.max(1, Math.ceil(v / DEFAULT_CONTEXTS_PER_BROWSER));
  if (opts.concurrency) return { value: opts.concurrency, source: 'opts.concurrency', browsers: shape(opts.concurrency) };
  if (+process.env.PTEST_CONCURRENCY > 0) return { value: +process.env.PTEST_CONCURRENCY, source: 'env PTEST_CONCURRENCY', browsers: shape(+process.env.PTEST_CONCURRENCY) };
  if (opts.useCalibration || process.env.PTEST_USE_CALIBRATION === '1') {
    const cal = readCalibration({ allowStale: false }), prof = opts.profile || 'virtual';
    if (cal && !cal.contaminated && cal[prof] && cal[prof].knee) return { value: cal[prof].knee, source: `calibration (${prof})`, browsers: opts.browsers || envB || cal[prof].browsers || shape(cal[prof].knee) };
  }
  const v = defaultConcurrency();
  return { value: v, source: `default (cpu count ${v}, ${DEFAULT_CONTEXTS_PER_BROWSER} contexts per browser)`, browsers: shape(v) };
}
/* ======================================================================================================
   adaptive concurrency: one machine-wide page budget shared through lease files, and a two-way controller
   ======================================================================================================
   Every running runMatrix (in any node process, any agent) keeps a lease file in LEASE_DIR saying how many pages it holds,
   refreshed every tick. A run may use what the others leave free, and always at least its fair share. So 8 agents testing at
   once share PAGE_BUDGET pages, and when 7 finish the 8th grows into the space. No caller has to guess a concurrency.
   PTEST_CONCURRENCY / opts.concurrency become the starting point; PTEST_ADAPT=0 (or opts.adapt:false) pins it. */
export const LEASE_DIR = process.env.PTEST_LEASE_DIR || path.join(os.tmpdir(), 'ptest-leases');
