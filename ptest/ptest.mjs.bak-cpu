/* ======================================================================================================
   runMatrix
   ====================================================================================================== */
const DEFAULT_IGNORE_CONSOLE = [/net::ERR_INTERNET_DISCONNECTED/];
export function contextOptions(c, opts = {}) {
  const v = vp(c.vp || c.viewport || opts.vp);
  const touch = c.touch ?? c.hasTouch ?? opts.touch ?? (v.width < 1024);
  return {
    viewport: v, deviceScaleFactor: c.dpr ?? opts.dpr ?? 1, hasTouch: touch, isMobile: c.isMobile ?? opts.isMobile ?? false,
    reducedMotion: c.reducedMotion || (c.rm ? 'reduce' : null) || opts.reducedMotion || 'no-preference',
