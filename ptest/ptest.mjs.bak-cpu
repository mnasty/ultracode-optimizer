/** fast REAL time (no fake clock): every CSS/WAAPI animation's timeline runs `rate` x faster (CDP). Timers stay real. */
export async function speedAnimations(page, rate = 10) {
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Animation.enable'); await cdp.send('Animation.setPlaybackRate', { playbackRate: rate });
  return cdp;
}

/* ======================================================================================================
   animation seeking: deterministic frames without waiting
   ====================================================================================================== */
