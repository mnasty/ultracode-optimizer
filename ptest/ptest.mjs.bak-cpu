  const write = (pages) => { try { fs.writeFileSync(file, JSON.stringify({ pid: process.pid, name, pages, t: Date.now() })); } catch { } };
  const close = () => { try { fs.unlinkSync(file); } catch { } };
  process.once('exit', close);
  return { file, write, close };
