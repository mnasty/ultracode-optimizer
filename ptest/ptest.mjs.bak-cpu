  for (const r of rep.results) L.push(`${pad(r.i, 4)}${pad(r.id, 42)}${pad(r.ok ? 'ok' : 'FAIL', 7)}${pad(fmtMs(r.ms), 9)}${pad(r.realWaitMs ? fmtMs(r.realWaitMs) : '-', 9)}${pad((r.pageErrors || []).length, 6)}${pad((r.consoleErrors || []).length, 7)}${r.ok ? (r.realtime && r.realtime.length ? 'REAL-TIME: ' + r.realtime.join(',') : '') : (r.error || '').slice(0, 120)}`);
  L.push(`[ptest] ${rep.name}: ${rep.passed}/${rep.cases} passed | wall ${fmtMs(rep.wallMs)} vs summed case time ${fmtMs(rep.sumMs)} = ${rep.speedup}x parallel speed-up (launch ${fmtMs(rep.launchMs)}, close ${fmtMs(rep.closeMs)}) | concurrency ${rep.concurrency}${rep.finalConcurrency !== rep.concurrency ? '->' + rep.finalConcurrency : ''} x ${rep.browsers} browser(s) | machine cpu ${rep.sys.cpuBusyPct}% busy, load ${rep.sys.load1}, swapDelta ${rep.sys.swapUsedDeltaMB}MB pageouts+${rep.sys.pageoutsDelta}`);
